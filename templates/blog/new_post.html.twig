{% extends 'base.html.twig' %}

{% block title %}New Post | Neon Store{% endblock %}
{% block body_class %}landing-page{% endblock %}

{% block body %}
<section class="post-neon">
    <div class="container">
        <div class="post-neon__header text-center">
            <p class="post-neon__kicker">PUBLISH TO THE BLOG</p>
            <h1>Create a new post</h1>
            <p>Share your latest story, insights, and visuals with the NeonSpark community.</p>
        </div>

        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                <div class="post-neon__card">
                    {{ form_start(form, {'attr': {'class': 'post-neon__form'}}) }}
                        {{ form_row(form.Title, {'attr': {'class': 'form-control post-neon__input'}}) }}
                        {{ form_row(form.Content, {'attr': {'class': 'form-control post-neon__textarea', 'rows': 8}}) }}
                        {{ form_row(form.Image, {'attr': {'class': 'form-control post-neon__file'}}) }}

                        <div class="text-right">
                            {{ form_row(form.Send, {'label': 'Publish post', 'attr': {'class': 'btn btn-lg landing-cta'}}) }}
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
